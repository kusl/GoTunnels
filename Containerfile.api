# Containerfile.api — multi-stage build for the GoTunnels API.
#
# go.sum is not committed, so the builder resolves the module graph with
# `go mod download` (cached as its own layer, keyed on go.mod only) and then
# `go mod tidy`. The final image is distroless: no shell, no package manager,
# runs as nonroot.

FROM docker.io/library/golang:1.27-trixie AS build
WORKDIR /src

ENV CGO_ENABLED=0 \
    GOFLAGS=-mod=mod \
    GOTOOLCHAIN=local

COPY go.mod ./
RUN go mod download

COPY . .

ARG VERSION=dev
RUN go mod tidy \
 && go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/api ./cmd/api

FROM gcr.io/distroless/static-debian13:nonroot
WORKDIR /
COPY --from=build /out/api /api
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/api"]
